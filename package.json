{
  "name": "copy-gate",
  "version": "1.0.0",
  "private": true,
  "description": "Six-layer copy check (Jung, Freud, Sales 101, SEO, AI-SEO, Platform), weighted per task: deterministic scores, findings and rewrite priorities.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "agensi": {
    "creditPending": true
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test kernel.test.mjs skill.test.mjs",
    "zip": "node make-zip.mjs",
    "gate": "node gate.mjs --witness ../witness/witness.mjs",
    "verify-receipt": "node gate.mjs --verify"
  }
}
